NODE_ENV=development
PORT=5000

# ── Local MySQL (recommended for local testing) ──────────────────────────
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bizmanage
DB_USER=root
DB_PASSWORD=your_database_password

# ── OR: TiDB Cloud / hosted MySQL-compatible DB (for production) ────────
# DB_DIALECT=mysql
# DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_NAME=your_db_name
# DB_USER=your_tidb_user
# DB_PASSWORD=your_tidb_password
# DB_SSL=true
# Or a single connection URL instead of the individual DB_* vars above:
# DATABASE_URL=mysql://user:password@host:4000/dbname?sslaccept=accept_invalid_certs

JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
JWT_REFRESH_EXPIRY=7d

# Comma-separate multiple origins if needed (e.g. local + deployed frontend)
CORS_ORIGIN=http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
STOCK_ALERT_CRON=*/15 * * * *

# No email provider is wired up in this build. forgot-password works end to
# end, but in development the reset link is returned directly in the API
# response (and logged server-side) instead of emailed. Configure a real
# provider (e.g. Resend, SendGrid) before going to production.
