NODE_ENV=production
PORT=5000
HOST=0.0.0.0
DB_HOST=127.0.0.1
DB_PORT=4000
DB_NAME=bizmanage
DB_USER=root
DB_PASSWORD=
DB_DIALECT=tidb
DB_SSL=true
# Or use a full TiDB/TiDB Cloud connection URL:
# DATABASE_URL=mysql://user:password@host:4000/dbname?sslaccept=accept_invalid_certs
JWT_ACCESS_SECRET=your_access_secret_key_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRY=7d
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
STOCK_ALERT_CRON=*/15 * * * *
EMAIL_FROM=no-reply@bizmanage.com
EMAIL_PROVIDER_API_KEY=your_email_api_key_here
